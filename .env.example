# Backend
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000
CLIPFORGE_DATABASE_URL=sqlite:///./data/clipforge.db
CLIPFORGE_STORAGE_DIR=./data
CLIPFORGE_CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# Optional explicit paths. Leave blank to use PATH detection.
CLIPFORGE_FFMPEG_PATH=
CLIPFORGE_FFPROBE_PATH=

# Optional AI metadata providers. Gemini sends only a chosen clip transcript to Google when enabled.
CLIPFORGE_OLLAMA_URL=http://127.0.0.1:11434
CLIPFORGE_OLLAMA_MODEL=llama3.2
CLIPFORGE_GEMINI_API_KEY=
CLIPFORGE_GEMINI_MODEL=gemini-2.0-flash
